<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OrganizadorDescargas.Pages.FolderOrganizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Margin="30,30,30,30" Spacing="16">

            <!-- Header -->
            <Grid>
                <TextBlock Text="Organizar carpeta" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <Button x:Name="ScanBtn" Content="Escanear"
                        HorizontalAlignment="Right"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                        Click="ScanBtn_Click" />
            </Grid>

            <!-- Folder picker -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="16">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Grid.Column="0"
                             PlaceholderText="Selecciona una carpeta para organizar..."
                             IsReadOnly="True" />
                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="Explorar"
                            Click="BrowseBtn_Click" />
                </Grid>
            </Border>

            <!-- Stats bar -->
            <Border x:Name="StatsBar" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="20,14">
                <StackPanel Orientation="Horizontal" Spacing="32">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TotalFilesLabel" Text="0" FontSize="26" FontWeight="Bold" Foreground="#2563EB" />
                        <TextBlock Text="archivos" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="WillMoveLabel" Text="0" FontSize="26" FontWeight="Bold" Foreground="#10B981" />
                        <TextBlock Text="se organizarán" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="NoRuleLabel" Text="0" FontSize="26" FontWeight="Bold" Foreground="#F59E0B" />
                        <TextBlock Text="sin categoría" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Preview section -->
            <Border x:Name="PreviewSection" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Vista previa" FontSize="15" FontWeight="SemiBold" />
                    <StackPanel x:Name="PreviewPanel" Spacing="8" />
                </StackPanel>
            </Border>

            <!-- Organize button -->
            <Button x:Name="OrganizeBtn" Content="Organizar ahora" Visibility="Collapsed"
                    Background="#10B981" Foreground="White" FontWeight="SemiBold"
                    HorizontalAlignment="Stretch" Padding="0,14"
                    HorizontalContentAlignment="Center"
                    Click="OrganizeBtn_Click" />

        </StackPanel>
    </ScrollViewer>
</Page>
