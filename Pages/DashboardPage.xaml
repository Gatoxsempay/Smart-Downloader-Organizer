<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OrganizadorDescargas.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Margin="30,30,30,30" Spacing="16">

            <!-- Header -->
            <Grid>
                <TextBlock Text="Panel principal" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button x:Name="OrganizeNowBtn" Content="Organizar ahora"
                            Click="OrganizeNowBtn_Click" />
                    <Button x:Name="ToggleBtn" Content="Iniciar"
                            Background="#2563EB" Foreground="White"
                            FontWeight="SemiBold"
                            Click="ToggleBtn_Click" />
                </StackPanel>
            </Grid>

            <!-- Status bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" />
                        <TextBlock x:Name="StatusLabel" Text="Detenido" FontWeight="SemiBold" Foreground="Gray" />
                    </StackPanel>
                    <TextBlock x:Name="FolderLabel" HorizontalAlignment="Right"
                               FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Stat cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total movidos -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TotalLabel" Text="0" FontSize="34" FontWeight="Bold"
                                   Foreground="#2563EB" HorizontalAlignment="Center" />
                        <TextBlock Text="Total movidos" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Hoy -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="📅" FontSize="26" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TodayLabel" Text="0" FontSize="34" FontWeight="Bold"
                                   Foreground="#10B981" HorizontalAlignment="Center" />
                        <TextBlock Text="Hoy" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Categorías -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="🗂" FontSize="26" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CatsLabel" Text="0" FontSize="34" FontWeight="Bold"
                                   Foreground="#8B5CF6" HorizontalAlignment="Center" />
                        <TextBlock Text="Categorías" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Activity feed -->
            <TextBlock Text="Actividad reciente" FontSize="15" FontWeight="SemiBold" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14" MinHeight="200">
                <ScrollViewer x:Name="FeedScroll" MaxHeight="400">
                    <StackPanel x:Name="FeedPanel" Margin="8" Spacing="4">
                        <TextBlock x:Name="EmptyLabel"
                                   Text="Sin actividad aún — inicia el organizador para comenzar."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12" Margin="8,24" HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
