<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OrganizadorDescargas.Pages.FileManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OrganizadorDescargas.Models"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="30,30,30,10">
            <StackPanel>
                <TextBlock Text="Explorador avanzado" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Navega y analiza tus archivos con metadatos detallados"
                           FontSize="13" Margin="0,2,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CheckBox x:Name="RecursiveCheck"
                      Content="Incluir subcarpetas"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      IsChecked="False"
                      Checked="RecursiveCheck_Changed"
                      Unchecked="RecursiveCheck_Changed" />
        </Grid>

        <!-- Navigation bar -->
        <Border Grid.Row="1" Margin="30,0,30,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12" Padding="12,8">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"    />
                    <ColumnDefinition Width="180"  />
                    <ColumnDefinition Width="150"  />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackBtn"    Grid.Column="0" Content="←" Width="34" Height="32"
                        IsEnabled="False" Click="BackBtn_Click" />
                <Button x:Name="ForwardBtn" Grid.Column="1" Content="→" Width="34" Height="32"
                        IsEnabled="False" Click="ForwardBtn_Click" />
                <Button x:Name="UpBtn"      Grid.Column="2" Content="↑" Width="34" Height="32"
                        IsEnabled="False" Click="UpBtn_Click" />

                <TextBox x:Name="AddressBar" Grid.Column="3"
                         PlaceholderText="Escribe una ruta y presiona Enter…"
                         KeyDown="AddressBar_KeyDown" />

                <TextBox x:Name="FilterBox" Grid.Column="4"
                         PlaceholderText="Filtrar…"
                         TextChanged="FilterBox_TextChanged" />

                <ComboBox x:Name="SortCombo" Grid.Column="5"
                          SelectedIndex="0"
                          SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem Content="Nombre"     Tag="Name"     />
                    <ComboBoxItem Content="Tipo"       Tag="Type"     />
                    <ComboBoxItem Content="Tamaño"     Tag="Size"     />
                    <ComboBoxItem Content="Modificado" Tag="Modified" />
                    <ComboBoxItem Content="Aperturas"  Tag="Opens"    />
                </ComboBox>

                <Button x:Name="SortDirBtn" Grid.Column="6"
                        Content="↑ Asc" MinWidth="72"
                        Background="#374151" Foreground="White"
                        Click="SortDirBtn_Click" />
            </Grid>
        </Border>

        <!-- Stats bar -->
        <Border x:Name="StatsBar" Grid.Row="2" Visibility="Collapsed"
                Margin="30,0,30,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12" Padding="20,12">
            <StackPanel Orientation="Horizontal" Spacing="32">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="FileCountLabel" Text="0"
                               FontSize="20" FontWeight="Bold" Foreground="#2563EB" />
                    <TextBlock Text="archivos" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="FolderCountLabel" Text="0"
                               FontSize="20" FontWeight="Bold" Foreground="#8B5CF6" />
                    <TextBlock Text="carpetas" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="SizeLabel" Text="0 KB"
                               FontSize="20" FontWeight="Bold" Foreground="#10B981" />
                    <TextBlock Text="tamaño total" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="OpensLabel" Text="0"
                               FontSize="20" FontWeight="Bold" Foreground="#F59E0B" />
                    <TextBlock Text="aperturas" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main content: tree + file list -->
        <Grid Grid.Row="3" Margin="30,0,30,30" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*"   />
            </Grid.ColumnDefinitions>

            <!-- Folder tree -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                <TreeView x:Name="FolderTree"
                          SelectionMode="Single"
                          Margin="4,8,4,8"
                          ItemInvoked="FolderTree_ItemInvoked"
                          Expanding="FolderTree_Expanding">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,2">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13"
                                          Foreground="#2563EB"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Content.DisplayName}" FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- File list -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"    />
                    </Grid.RowDefinitions>

                    <!-- Column headers -->
                    <Border Grid.Row="0" Padding="12,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="12,12,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"           />
                                <ColumnDefinition Width="2*" MinWidth="140" />
                                <ColumnDefinition Width="80"           />
                                <ColumnDefinition Width="90"           />
                                <ColumnDefinition Width="140"          />
                                <ColumnDefinition Width="70"           />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text=""          />
                            <TextBlock Grid.Column="1" Text="Nombre"     FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Tipo"       FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Tamaño"     FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Modificado" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="Aperturas"  FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- State elements (loading / empty) -->
                    <StackPanel x:Name="LoadingPanel" Grid.Row="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="12" Visibility="Visible">
                        <ProgressRing x:Name="ScanRing" Width="40" Height="40"
                                      IsActive="True" HorizontalAlignment="Center" />
                        <TextBlock x:Name="LoadingLabel" Text="Iniciando explorador…"
                                   FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock x:Name="EmptyLabel" Grid.Row="1"
                               Text="Selecciona una carpeta en el árbol de la izquierda"
                               Visibility="Collapsed"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="300"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- ListView -->
                    <ListView x:Name="FilesList" Grid.Row="1"
                              SelectionMode="Single"
                              Visibility="Collapsed"
                              DoubleTapped="FilesList_DoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,5" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileSystemItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"           />
                                        <ColumnDefinition Width="2*" MinWidth="140" />
                                        <ColumnDefinition Width="80"           />
                                        <ColumnDefinition Width="90"           />
                                        <ColumnDefinition Width="140"          />
                                        <ColumnDefinition Width="70"           />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="{x:Bind Glyph}" FontSize="13"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeDisplay}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeDisplay}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <TextBlock Grid.Column="4" Text="{x:Bind ModifiedDisplay}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <TextBlock Grid.Column="5" Text="{x:Bind OpenDisplay}"
                                               FontSize="12" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
