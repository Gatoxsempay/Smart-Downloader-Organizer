<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OrganizadorDescargas.Pages.GhostFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="30,30,30,16">
            <StackPanel>
                <TextBlock Text="Archivos fantasma" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Detecta archivos pesados que llevan meses sin usarse y consumen espacio innecesariamente"
                           FontSize="13" Margin="0,2,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Barra de configuración -->
        <Border Grid.Row="1" Margin="30,0,30,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12" Padding="16,12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Busca en Descargas, Escritorio, Documentos, Imágenes, Videos y Música."
                           VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ComboBox x:Name="MonthsCombo" Grid.Column="1"
                          SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem Content="Sin acceso en 3 meses" Tag="3" />
                    <ComboBoxItem Content="Sin acceso en 6 meses" Tag="6" />
                    <ComboBoxItem Content="Sin acceso en 12 meses" Tag="12" />
                </ComboBox>

                <ComboBox x:Name="SizeCombo" Grid.Column="2"
                          SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem Content="Mayores de 100 MB" Tag="100" />
                    <ComboBoxItem Content="Mayores de 500 MB" Tag="500" />
                    <ComboBoxItem Content="Mayores de 1 GB" Tag="1024" />
                </ComboBox>

                <Button x:Name="ScanBtn" Grid.Column="3"
                        Content="Analizar"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                        Padding="16,8"
                        Click="ScanBtn_Click" />
            </Grid>
        </Border>

        <!-- Barra de progreso -->
        <Border x:Name="StatusBar" Grid.Row="2" Visibility="Collapsed"
                Margin="30,0,30,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="ScanRing" Width="20" Height="20" IsActive="True"
                              VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Resultados -->
        <Border x:Name="ResultsBorder" Grid.Row="3" Visibility="Collapsed"
                Margin="30,0,30,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezados columna -->
                <Border Grid.Row="0" Padding="12,10"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="12,12,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="2*" MinWidth="160" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" />
                        <TextBlock Grid.Column="1" Text="Archivo"      FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Tamaño"       FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Último acceso" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Modificado"   FontSize="11" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ListView x:Name="GhostList" Grid.Row="1"
                          SelectionMode="Multiple">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,5" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Border>

        <!-- Barra de acciones -->
        <Border x:Name="ActionBar" Grid.Row="4" Visibility="Collapsed"
                Margin="30,12,30,30"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12" Padding="16,12">
            <Grid>
                <TextBlock x:Name="CountLabel" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="OpenFolderBtn" Content="Abrir ubicación"
                            Background="#374151" Foreground="White"
                            Click="OpenFolderBtn_Click" />
                    <Button x:Name="DeleteBtn"
                            Content="Eliminar seleccionados"
                            Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                            Padding="16,8"
                            Click="DeleteBtn_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
