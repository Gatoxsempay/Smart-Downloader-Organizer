<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OrganizadorDescargas.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Margin="30,30,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Registros" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Content="Limpiar" HorizontalAlignment="Right" Click="ClearBtn_Click" />
        </Grid>

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="14">
            <ScrollViewer x:Name="LogScroll">
                <StackPanel x:Name="LogPanel" Margin="12" Spacing="2">
                    <TextBlock x:Name="EmptyLabel"
                               Text="Sin registros aún."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" Margin="8,20" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
