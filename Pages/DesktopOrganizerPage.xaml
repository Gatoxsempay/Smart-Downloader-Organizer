<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OrganizadorDescargas.Pages.DesktopOrganizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Margin="30,30,30,30" Spacing="16">

            <!-- Header -->
            <Grid>
                <TextBlock Text="Organizar escritorio" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <Button x:Name="ScanBtn" Content="Escanear escritorio"
                        HorizontalAlignment="Right"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                        Click="ScanBtn_Click" />
            </Grid>

            <!-- Info banner -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="¿Cómo funciona?" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        Los archivos y accesos directos del escritorio se moverán a subcarpetas organizadas por categoría
                        (Imágenes, Documentos, Accesos Directos, etc.). Las carpetas existentes no se tocan.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Stats bar -->
            <Border x:Name="StatsBar" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="20,14">
                <StackPanel Orientation="Horizontal" Spacing="32">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TotalFilesLabel" Text="0" FontSize="26" FontWeight="Bold" Foreground="#2563EB" />
                        <TextBlock Text="archivos" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="WillMoveLabel" Text="0" FontSize="26" FontWeight="Bold" Foreground="#10B981" />
                        <TextBlock Text="se organizarán" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="NoRuleLabel" Text="0" FontSize="26" FontWeight="Bold" Foreground="#F59E0B" />
                        <TextBlock Text="sin categoría" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Preview section -->
            <Border x:Name="PreviewSection" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Vista previa" FontSize="15" FontWeight="SemiBold" />
                    <StackPanel x:Name="PreviewPanel" Spacing="8" />
                </StackPanel>
            </Border>

            <!-- Organize button -->
            <Button x:Name="OrganizeBtn" Content="Organizar escritorio" Visibility="Collapsed"
                    Background="#10B981" Foreground="White" FontWeight="SemiBold"
                    HorizontalAlignment="Stretch" Padding="0,14"
                    HorizontalContentAlignment="Center"
                    Click="OrganizeBtn_Click" />

            <!-- Coming soon: Zones -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="16" Opacity="0.6">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE81E;" FontSize="18" Foreground="#8B5CF6" />
                        <TextBlock Text="Zonas de escritorio  —  Próximamente"
                                   FontWeight="SemiBold" FontSize="13" Foreground="#8B5CF6"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        Define áreas fijas en tu escritorio para agrupar visualmente tus aplicaciones:
                        Juegos, Trabajo, Programación, etc. La app posicionará los iconos
                        automáticamente en cada zona al aplicar el layout.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
