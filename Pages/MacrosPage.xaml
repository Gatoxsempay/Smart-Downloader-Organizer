<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OrganizadorDescargas.Pages.MacrosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="30,30,30,16">
            <StackPanel>
                <TextBlock Text="Acciones rápidas" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Crea acciones automáticas y ejecútalas con un clic"
                           FontSize="13" Margin="0,2,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="AddMacroBtn" Content="+ Nueva acción rápida"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                    Padding="16,8"
                    Click="AddMacroBtn_Click" />
        </Grid>

        <!-- Lista de macros (construida en code-behind) -->
        <ScrollViewer Grid.Row="1" Margin="30,0,30,30">
            <StackPanel x:Name="MacrosList" Spacing="12" />
        </ScrollViewer>
    </Grid>
</Page>
