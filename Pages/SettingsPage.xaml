<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OrganizadorDescargas.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Margin="30,30,30,30" Spacing="16">
            <TextBlock Text="Ajustes" FontSize="24" FontWeight="Bold" />

            <!-- Carpeta monitoreada -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="22,20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Carpeta monitoreada" FontSize="15" FontWeight="SemiBold" />
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="FolderBox" IsReadOnly="True" Width="420" />
                        <Button Content="Cambiar" Click="ChangeFolder_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Comportamiento -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="22,20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Comportamiento" FontSize="15" FontWeight="SemiBold" />
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid>
                        <TextBlock Text="Iniciar monitoreo automáticamente al abrir" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="AutoStartSwitch" HorizontalAlignment="Right" Toggled="AutoStart_Toggled" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Organizar archivos existentes al iniciar" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="OrganizeOnStartSwitch" HorizontalAlignment="Right" Toggled="OrganizeOnStart_Toggled" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Iniciar con Windows" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="WindowsStartSwitch" HorizontalAlignment="Right" Toggled="WindowsStart_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Apariencia -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="22,20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Apariencia" FontSize="15" FontWeight="SemiBold" />
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid>
                        <TextBlock Text="Tema de la aplicación" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Right"
                                  SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="Oscuro" Tag="dark" />
                            <ComboBoxItem Content="Claro" Tag="light" />
                            <ComboBoxItem Content="Sistema" Tag="default" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Zona de riesgo -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="22,20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Zona de riesgo" FontSize="15" FontWeight="SemiBold" />
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Text="Reinicia el contador de estadísticas a cero."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Restablecer estadísticas" Background="#c0392b" Foreground="White"
                            Click="ResetStats_Click" />

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Text="Devuelve todos los archivos organizados a la carpeta Descargas y elimina las subcarpetas vacías."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="Desorganizar archivos" Background="#c0392b" Foreground="White"
                            Click="Reverse_Click" />

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Text="Elimina la configuración, los registros y el inicio automático con Windows. Después podrás borrar el archivo .exe manualmente."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="Desinstalar software" Background="#7b241c" Foreground="White"
                            Click="Uninstall_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
