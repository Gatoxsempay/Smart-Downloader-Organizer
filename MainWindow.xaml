<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OrganizadorDescargas.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Organizador de PC"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Organizador de PC"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Update banner (hidden by default) -->
        <Border
            x:Name="UpdateBanner"
            Grid.Row="1"
            Background="#1a5c38"
            Padding="16,10"
            Visibility="Collapsed">
            <Grid>
                <TextBlock
                    x:Name="UpdateText"
                    Foreground="White"
                    FontSize="13"
                    VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="DownloadBtn" Content="Descargar"
                            Background="#0d3d22" Foreground="White"
                            Click="DownloadBtn_Click" />
                    <Button Content="×" Background="Transparent" Foreground="White"
                            FontSize="16" Click="DismissBanner_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="NavView"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Panel" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Carpetas" Tag="folders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Escritorio" Tag="desktop">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Explorador" Tag="filemanager">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC50;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Macros" Tag="macros">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Duplicados" Tag="duplicates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Fantasmas" Tag="ghosts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Reglas" Tag="rules">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Exclusiones" Tag="exclusions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Registros" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Ajustes" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Padding="16,4,16,16" Spacing="8">
                    <Button x:Name="ToolbarToggleBtn"
                            HorizontalAlignment="Stretch"
                            Background="#1E3A5F" Foreground="White"
                            Padding="12,8"
                            Click="ToolbarToggleBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA37;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Barra portátil" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="StatusEllipse" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Detenido" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
