<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OrganizadorDescargas.ToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Barra portátil">

    <!--
        RootGrid is set as the title bar — any empty area of the toolbar can be
        dragged to move it. Buttons inside are still interactive as usual.
    -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="12">

        <!-- Main bar content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Grip hint — non-interactive, signals that the bar is draggable -->
            <TextBlock Grid.Column="0"
                       Text="&#x2237;&#x2237;"
                       FontSize="11"
                       Opacity="0.35"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Margin="8,0,4,0"
                       ToolTipService.ToolTip="Arrastra para mover la barra" />

            <!-- Scrollable buttons area -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollMode="Auto"
                          VerticalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ButtonsPanel"
                            Orientation="Horizontal"
                            Spacing="4"
                            Padding="4,0" />
            </ScrollViewer>

            <!-- Controls: Add, Pin, Auto-collapse, Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Padding="4,0">
                <Button x:Name="AddBtn" Width="36" Height="36"
                        ToolTipService.ToolTip="Agregar botón"
                        Background="Transparent"
                        Click="AddBtn_Click">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <ToggleButton x:Name="PinBtn" Width="36" Height="36"
                              ToolTipService.ToolTip="Mantener encima de todo"
                              Background="Transparent"
                              Checked="PinBtn_Checked"
                              Unchecked="PinBtn_Unchecked">
                    <FontIcon Glyph="&#xE840;" FontSize="13" />
                </ToggleButton>
                <ToggleButton x:Name="CollapseToggle" Width="36" Height="36"
                              ToolTipService.ToolTip="Colapsar al perder foco"
                              Background="Transparent"
                              Checked="CollapseToggle_Changed"
                              Unchecked="CollapseToggle_Changed">
                    <FontIcon Glyph="&#xF0AF;" FontSize="13" />
                </ToggleButton>
                <Button x:Name="CloseBtn" Width="36" Height="36"
                        ToolTipService.ToolTip="Cerrar barra"
                        Background="Transparent"
                        Click="CloseBtn_Click">
                    <FontIcon Glyph="&#xE8BB;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Collapsed overlay (shown when auto-collapse is active and focus is lost) -->
        <Border x:Name="CollapsedView"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                Visibility="Collapsed"
                PointerEntered="CollapsedView_PointerEntered">
            <FontIcon Glyph="&#xEA37;" FontSize="20"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="#2563EB" />
        </Border>
    </Grid>
</Window>
